# ═══════════════════════════════════════════════════════════════
# NanoBananaGen2 — Gemini/NanoBanana 图像生成插件配置
# ═══════════════════════════════════════════════════════════════
#
# 本插件支持两种协议：
# 1. Chat 协议：通过 /chat/completions 端点（兼容 OpenAI Chat API）
# 2. Images 协议：通过 /v1/images/generations 和 /v1/images/edits 端点（OpenAI Images API）
#
# 支持三种调用策略：
# - fallback：故障转移（优先使用一种协议，失败时降级到另一种）
# - polling：轮询（chat 和 images 交替调用）
# - random：随机选择协议
#
# 【重要】URL 请填到 /v1 为止，插件会自动拼接具体端点

# ═══════════════════════════════════════════════════════════════
# 协议调用策略配置
# ═══════════════════════════════════════════════════════════════

# 调用模式：fallback（故障转移）/ polling（轮询）/ random（随机）
PROTOCOL_MODE=fallback

# 故障转移优先级（仅在 PROTOCOL_MODE=fallback 时生效）
# images：优先使用 images 协议，失败降级到 chat
# chat：优先使用 chat 协议，失败降级到 images
FALLBACK_PRIORITY=images

# ═══════════════════════════════════════════════════════════════
# Chat 协议配置
# ═══════════════════════════════════════════════════════════════

# Chat API 地址（填到 /v1 为止）
CHAT_API_URL=http://127.0.0.1:8080/v1

# Chat API 密钥（不需要则留空）
CHAT_API_KEY=

# Chat 模型名称（多个用英文逗号隔开，每次调用随机选一个）
# 常见值：
#   OpenRouter:      google/gemini-2.5-flash-image-preview
#   反重力/自定义:    hyb-Optimal/antigravity/gemini-3-pro-image
#   Gemini 官方兼容:  gemini-2.5-flash-image-preview
CHAT_MODELS=hyb-Optimal/antigravity/gemini-3-pro-image

# ═══════════════════════════════════════════════════════════════
# Images 协议配置
# ═══════════════════════════════════════════════════════════════

# Images API 地址（填到 /v1 为止，留空则不使用 images 协议）
IMAGES_API_URL=https://wisart.kuaileshifu.com

# Images API 密钥（不需要则留空）
IMAGES_API_KEY=

# Images 模型名称（多个用英文逗号隔开，每次调用随机选一个）
IMAGES_MODELS=gpt-image-2

# ═══════════════════════════════════════════════════════════════
# 兼容旧版配置（已废弃，但仍支持）
# ═══════════════════════════════════════════════════════════════

# 如果设置了以下旧版配置，会自动映射到 Chat 协议配置
# API_URL → CHAT_API_URL
# API_KEY → CHAT_API_KEY
# NANO_BANANA_MODEL → CHAT_MODELS

# 多渠道模式已废弃，请使用新的双协议配置
MULTI_CHANNEL=false
API_CHANNELS=

# ═══════════════════════════════════════════════════════════════
# 通用配置（可选）
# ═══════════════════════════════════════════════════════════════

# 代理地址（例如 http://127.0.0.1:7890，不需要则留空）
NanoBananaProxy=

# 分布式图床地址，用于 file:// 路径的降级处理
# 格式: http://<ip>:<port>/pw=<key>（多个用逗号隔开）
DIST_IMAGE_SERVERS=

# 是是否使用公网地址返回图片URL，true 表示使用 VAR_HTTPS_URL，false 表示使用 VAR_HTTP_URL（局域网）
USE_PUBLIC_URL=false