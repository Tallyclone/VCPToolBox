# RhinoVCP 建模工具默认全部可用；如需只读环境，可显式改为 false。
RHINO_VCP_ALLOW_CODE_EXECUTION=true
RHINO_VCP_ALLOW_FILE_OPERATIONS=true

# 可选：仅允许逗号分隔的工具名；留空表示不额外限制。
RHINO_VCP_ALLOWED_TOOLS=

# 可选：多 Rhino 实例时指定目标 Rhino 进程 PID；留空时选择最新注册实例。
RHINO_VCP_INSTANCE_PID=

# Daemon 在 VCP 120 秒宿主超时前主动停止等待，并发送 __cancel。
RHINO_VCP_TOOL_WAIT_TIMEOUT_MS=110000

# Daemon 从 %APPDATA%\RhinoVCP\instances\*.json 发现当前用户的 Rhino 实例。
